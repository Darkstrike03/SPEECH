# Default engine: "google" (SpeechRecognition -> Google Web Speech, no key)
# or "whisper" (local faster-whisper model).
DEFAULT_ENGINE=google

# Local Whisper fallback (used when Google fails or engine=whisper).
WHISPER_MODEL_SIZE=tiny
WHISPER_MODEL_DIR=models

# Optional limits.
# MAX_UPLOAD_MB=25
# MAX_AUDIO_SECONDS=300
# MAX_STREAM_SECONDS=300
